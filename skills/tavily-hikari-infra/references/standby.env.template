# Store real values only in the deployment's protected environment file.
PROXY_BIND=127.0.0.1
PROXY_PORT=<local-port>
PROXY_DB_PATH=<protected-state-path>
XRAY_BINARY=<protected-binary-path>
XRAY_RUNTIME_DIR=<protected-runtime-path>
HA_MODE=active_standby
NODE_ID=<standby-node-id>
HA_SOURCE_KIND=direct
NODE_PUBLIC_SCHEME=https
NODE_PUBLIC_HOST=<standby-public-host>
NODE_PUBLIC_PORT=<standby-public-port>
HA_SYNC_SOURCE_URL=https://<primary-admin-origin>
HA_INTERNAL_TOKEN=<redacted>
HA_SYNC_INTERVAL_SECS=5
ADMIN_AUTH_PASSKEY_ENABLED=true
ADMIN_PASSKEY_RP_ID=<standby-public-host>
ADMIN_PASSKEY_RP_ORIGIN=https://<standby-public-host>:<standby-public-port>
ADMIN_AUTH_FORWARD_ENABLED=false
RUNTIME_LOG_FORMAT=json
LINUXDO_OAUTH_ENABLED=false
LINUXDO_CREDIT_ENABLED=false
