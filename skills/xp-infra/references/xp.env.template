# xp env key reference (NO SECRETS)
# Values are placeholders only. Never copy this file to a host unchanged.

# Identity / public control plane
XP_NODE_NAME=<redacted>
XP_ACCESS_HOST=<redacted>
XP_API_BASE_URL=<redacted>
XP_DATA_DIR=<redacted>
XP_CONTAINER_IMAGE_PREFIX=ghcr.io/example/xp

# Cluster authentication is managed by xp-ops during bootstrap or join. Audit never reads it.
XP_ADMIN_TOKEN_HASH=<redacted>

# Cloudflare Tunnel and DDNS
XP_ENABLE_CLOUDFLARE=true
XP_CLOUDFLARE_ACCOUNT_ID=<redacted>
XP_CLOUDFLARE_ZONE_ID=<redacted>
XP_CLOUDFLARE_HOSTNAME=<redacted>
XP_CLOUDFLARE_DDNS_ENABLED=true
XP_CLOUDFLARE_DDNS_ZONE_ID=<redacted>
XP_CLOUDFLARE_DDNS_TOKEN_FILE=<redacted>

# IP usage / Geo enrichment
XP_IP_GEO_ENABLED=true
XP_IP_GEO_ORIGIN=https://api.country.is

# Managed-default VLESS HTTPS canary
XP_VLESS_CANARY_BIND=<redacted>
XP_VLESS_CANARY_ACME_DIRECTORY_URL=<redacted>
XP_VLESS_CANARY_ACME_CONTACT_EMAIL=<redacted>
XP_VLESS_CANARY_CLOUDFLARE_TOKEN_FILE=<redacted>
# Optional: xp-ops first reuses the DDNS zone and then derives from the access host.
XP_VLESS_CANARY_CLOUDFLARE_ZONE_ID=<redacted>
XP_VLESS_CANARY_DNS_PROPAGATION_TIMEOUT_SECS=<redacted>

# Managed-default endpoint bootstrap
# Owner-confirmed bootstrap value only; audit discovers the active listener instead.
XP_DEFAULT_VLESS_PORT=<redacted>
XP_DEFAULT_VLESS_FINGERPRINT=chrome
# Deprecated compatibility input; does not choose managed SNI.
XP_DEFAULT_VLESS_SERVER_NAMES=<redacted>
# Keep unset: SS2022 is disabled by the cluster policy unless explicitly approved.

# Runtime integrations / restart policy
XP_XRAY_API_ADDR=<redacted>
XP_XRAY_HEALTH_INTERVAL_SECS=<redacted>
XP_XRAY_HEALTH_FAILS_BEFORE_DOWN=<redacted>
XP_XRAY_RESTART_MODE=<redacted>
XP_XRAY_RESTART_COOLDOWN_SECS=<redacted>
XP_XRAY_RESTART_TIMEOUT_SECS=<redacted>
XP_CLOUDFLARED_MONITOR_MODE=<redacted>
XP_CLOUDFLARED_RESTART_MODE=<redacted>
XP_MESH_PROXY_URL=<redacted>

# Stable service names
XP_XRAY_SYSTEMD_UNIT=xray.service
XP_XRAY_OPENRC_SERVICE=xray
