{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.3.2"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "description": "Bounded Agent VM task inventory and operation outcomes. This view is read-only and removes stale task rows after a successful scrape.",
  "editable": false,
  "graphTooltip": 0,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Agent VM inventory summary",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "agent_vm_up{job=\"$controller_job\"}",
          "instant": true,
          "legendFormat": "Controller up",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "agent_vm_admission_ready{job=\"$controller_job\"}",
          "instant": true,
          "legendFormat": "Admission ready",
          "refId": "B"
        }
      ],
      "title": "Controller scrape health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "sum(agent_vm_task_states{job=\"$controller_job\"})",
          "instant": true,
          "legendFormat": "Managed tasks",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "sum(agent_vm_task_states{job=\"$controller_job\",state=~\"preparing|closing|deleting|failed\"})",
          "instant": true,
          "legendFormat": "Pending operations",
          "refId": "B"
        }
      ],
      "title": "Task state counts",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "mappings": [],
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "agent_vm_scrape_timestamp_seconds{job=\"$controller_job\"} * 1000",
          "instant": true,
          "legendFormat": "Last successful scrape",
          "refId": "A"
        }
      ],
      "title": "Scrape freshness",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "(sum(agent_vm_operations_total{job=\"$controller_job\",outcome=\"failure\"}) + sum(agent_vm_image_unpack_failures_total{job=\"$controller_job\"})) or vector(0)",
          "instant": true,
          "legendFormat": "Failures",
          "refId": "A"
        }
      ],
      "title": "Operation failures & image unpack",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 6,
      "panels": [],
      "title": "Managed VM inventory",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "description": "One bounded row per managed task. The collector replaces the complete textfile atomically, so stale rows disappear after a successful scrape.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "agent_vm_task_info{job=\"$controller_job\",state=~\"$state\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "agent_vm_task_cpu_vcpu{job=\"$controller_job\",state=~\"$state\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}} CPU",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "agent_vm_task_memory_bytes{job=\"$controller_job\",state=~\"$state\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}} RAM",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "agent_vm_task_disk_bytes{job=\"$controller_job\",state=~\"$state\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}} disk",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "agent_vm_task_lease_expires_at_seconds{job=\"$controller_job\",state=~\"$state\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}} lease",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "agent_vm_task_ssh_mapping{job=\"$controller_job\",state=~\"$state\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}} SSH",
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "agent_vm_task_last_error_info{job=\"$controller_job\",state=~\"$state\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}} error",
          "refId": "G"
        }
      ],
      "title": "Managed VM inventory",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "task_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "environment": true,
              "instance": true,
              "job": true,
              "service": true,
              "Value #A": true,
              "state 2": true,
              "state 3": true,
              "state 4": true
            },
            "renameByName": {
              "state 1": "state",
              "Value #B": "CPU vCPU",
              "Value #C": "RAM bytes",
              "Value #D": "Disk bytes",
              "Value #E": "Lease expiry",
              "Value #F": "SSH mapping",
              "Value #G": "Last error"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "steps-post",
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "agent_vm_task_states{job=\"$controller_job\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "title": "Task state counts",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "sum by (outcome, phase) (rate(agent_vm_operations_total{job=\"$controller_job\"}[5m]))",
          "legendFormat": "{{outcome}} / {{phase}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "sum by (phase, reason) (rate(agent_vm_image_unpack_failures_total{job=\"$controller_job\"}[5m]))",
          "legendFormat": "image {{phase}} / {{reason}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "sum by (code) (rate(agent_vm_warnings_total{job=\"$controller_job\"}[5m]))",
          "legendFormat": "warning {{code}}",
          "refId": "C"
        }
      ],
      "title": "Operation outcomes & warnings",
      "type": "timeseries"
    }
  ],
  "refresh": "auto",
  "schemaVersion": 37,
  "style": "dark",
  "tags": [
    "agent-vm",
    "inventory"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "__CONTROLLER_JOB__",
          "value": "__CONTROLLER_JOB__"
        },
        "hide": 2,
        "includeAll": false,
        "label": "Controller job",
        "multi": false,
        "name": "controller_job",
        "options": [
          {
            "selected": true,
            "text": "__CONTROLLER_JOB__",
            "value": "__CONTROLLER_JOB__"
          }
        ],
        "query": "__CONTROLLER_JOB__",
        "skipUrlSync": false,
        "type": "custom"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "active",
            "preparing",
            "closing",
            "deleting",
            "failed",
            "cached"
          ],
          "value": [
            "active",
            "preparing",
            "closing",
            "deleting",
            "failed",
            "cached"
          ]
        },
        "hide": 0,
        "includeAll": true,
        "label": "Task state",
        "multi": true,
        "name": "state",
        "options": [],
        "query": "active,preparing,closing,deleting,failed,cached,absent",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "timezone": "",
  "title": "__DASHBOARD_TITLE__",
  "uid": "__DASHBOARD_UID__",
  "version": 0,
  "datasources": [
    {
      "type": "prometheus",
      "uid": "__PROMETHEUS_UID__"
    }
  ]
}
