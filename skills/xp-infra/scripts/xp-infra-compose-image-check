#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: xp-infra-compose-image-check EXPECTED_IMAGE" >&2
  exit 2
fi

expected_image="$1"
images="$(cat)"
nonempty_images="$(printf '%s\n' "${images}" | grep -v '^[[:space:]]*$' || true)"
[ "$(printf '%s\n' "${nonempty_images}" | grep -c .)" -eq 1 ]
printf '%s\n' "${nonempty_images}" | grep -Fxq "${expected_image}"
