#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
REF_DIR="${SKILL_DIR}/references"
CONFIG_DIR="${XP_INFRA_CONFIG_DIR:-}"
if [ -z "${CONFIG_DIR}" ]; then
  if [ -n "${XDG_CONFIG_HOME:-}" ]; then
    CONFIG_HOME="${XDG_CONFIG_HOME}"
  elif [ -n "${HOME:-}" ]; then
    CONFIG_HOME="${HOME}/.config"
  else
    CONFIG_HOME=""
  fi
  if [ -z "${CONFIG_HOME}" ]; then
    printf '%s\n' 'error: set XP_INFRA_CONFIG_DIR or HOME before using xp-infra' >&2
    exit 1
  fi
  CONFIG_DIR="${CONFIG_HOME}/xp-infra"
fi
HOSTS_FILE="${XP_HOSTS_FILE:-${CONFIG_DIR}/hosts.txt}"
POLICY_FILE="${XP_POLICY_FILE:-${CONFIG_DIR}/deployment-policy.yaml}"
AUDIT_REMOTE_SCRIPT="${SCRIPT_DIR}/xp-infra-audit-remote"
AUDIT_LOCAL_SCRIPT="${SCRIPT_DIR}/xp-infra-audit-local"
AUDIT_VLESS_REMOTE_SCRIPT="${SCRIPT_DIR}/xp-infra-audit-vless-remote"
XP_CONTAINER_IMAGE_PREFIX="${XP_CONTAINER_IMAGE_PREFIX:-ghcr.io/example/xp}"

SSH_CONNECT_TIMEOUT_SECS=10
PORT_PREFLIGHT_EXEC_TIMEOUT_SECS=60
MAX_AUDIT_RESPONSE_BYTES=65536
AUDIT_TEMP_FILE=""

cleanup_audit_temp_file() {
  [ -z "${AUDIT_TEMP_FILE:-}" ] || rm -f "$AUDIT_TEMP_FILE"
}

trap cleanup_audit_temp_file EXIT
trap 'cleanup_audit_temp_file; exit 1' HUP INT TERM

bounded_audit_output() (
  output_file="$(mktemp)" || exit 1
  trap 'rm -f "$output_file"' 0 HUP INT TERM
  if ! dd iflag=fullblock bs="$((MAX_AUDIT_RESPONSE_BYTES + 1))" count=1 of="$output_file" 2>/dev/null; then
    exit 1
  fi
  byte_count="$(wc -c < "$output_file" | tr -d '[:space:]')"
  case "$byte_count" in ''|*[!0-9]*) exit 1 ;; esac
  [ "$byte_count" -le "$MAX_AUDIT_RESPONSE_BYTES" ] || exit 1
  cat "$output_file"
)

curl_bounded() (
  status_file="$(mktemp)" || exit 1
  trap 'rm -f "$status_file"' 0 HUP INT TERM
  if (
    set +e
    curl "$@"
    curl_status=$?
    printf '%s\n' "$curl_status" > "$status_file"
  ) | bounded_audit_output; then
    bounded_status=0
  else
    bounded_status=$?
  fi
  curl_status="$(cat "$status_file" 2>/dev/null || true)"
  [ "$bounded_status" -eq 0 ] && [ "$curl_status" = 0 ]
)

curl_bounded_headers() (
  header_file="$1"
  shift
  header_pipe="$(mktemp)" || exit 1
  rm -f "$header_pipe"
  mkfifo "$header_pipe" || exit 1
  trap 'exec 3>&- || true; rm -f "$header_pipe"' EXIT
  trap 'exec 3>&- || true; rm -f "$header_pipe"; exit 1' HUP INT TERM
  exec 3<> "$header_pipe"
  (exec 3>&-; bounded_audit_output < "$header_pipe" > "$header_file") &
  header_pid=$!
  if curl_bounded -D "$header_pipe" "$@"; then
    body_status=0
  else
    body_status=$?
  fi
  exec 3>&-
  if wait "$header_pid"; then
    header_status=0
  else
    header_status=$?
  fi
  [ "$body_status" -eq 0 ] && [ "$header_status" -eq 0 ]
)

die() {
  echo "error: $*" >&2
  exit 1
}

warn() {
  echo "warn: $*" >&2
}

usage() {
  cat <<EOF
xp-infra: read-only ops helper for xp self-hosted nodes (ssh-alias only)

Usage:
  xp-infra inventory
  xp-infra policy check
  xp-infra port preflight <host>
  xp-infra audit <host>
  xp-infra status <host>
  xp-infra logs <host> [--tail N]
  xp-infra version <host>
  xp-infra tunnel <host> [--ui|--metrics] [--local-port PORT]

Notes:
  - Hosts are SSH aliases from ${HOSTS_FILE}
  - Policy is read from ${POLICY_FILE}
  - Public references/*.example files are templates only
  - Connection details live in ~/.ssh/config
  - This tool is intentionally read-only (no restarts/uploads)
EOF
}

require_ruby_yaml() {
  command -v ruby >/dev/null 2>&1 || die "ruby with the standard YAML library is required"
  ruby -e 'require "yaml"' >/dev/null 2>&1 || die "ruby YAML support is unavailable"
}

policy_values() {
  local host="${1:-}"
  [ -f "${POLICY_FILE}" ] || die "missing deployment policy: ${POLICY_FILE}"
  require_ruby_yaml

  ruby -ryaml -e '
    path, host, inventory_path = ARGV
    data = YAML.safe_load(File.read(path), permitted_classes: [], aliases: false)
    inventory = File.readlines(inventory_path, chomp: true).map { |line| line.sub(/#.*/, "").strip }.reject(&:empty?)
    fail "policy root must be a mapping" unless data.is_a?(Hash)
    fail "unknown policy root fields" unless (data.keys - %w[schema_version owner_confirmed geo public_hostname defaults node_overrides]).empty?
    fail "duplicate hosts inventory aliases" unless inventory.uniq.length == inventory.length
    fail "invalid hosts inventory alias" unless inventory.all? { |name| name.match?(/\A[a-z0-9][a-z0-9-]*\z/) }
    fail "schema_version must be 1" unless data["schema_version"] == 1
    fail "owner_confirmed must be true" unless data["owner_confirmed"] == true

    geo = data["geo"]
    fail "geo must be a mapping" unless geo.is_a?(Hash)
    fail "unknown geo fields" unless (geo.keys - %w[enabled origin owner_authorized_third_party_lookup]).empty?
    fail "geo.enabled must be true" unless geo["enabled"] == true
    fail "geo.origin must be https://api.country.is" unless geo["origin"] == "https://api.country.is"
    fail "geo owner authorization must be true" unless geo["owner_authorized_third_party_lookup"] == true

    public_hostname = data["public_hostname"]
    fail "public_hostname must be a mapping" unless public_hostname.is_a?(Hash)
    fail "unknown public_hostname fields" unless (public_hostname.keys - %w[zone]).empty?
    public_hostname_zone = public_hostname["zone"]
    fail "public_hostname.zone must be a valid DNS name" unless public_hostname_zone.is_a?(String) && public_hostname_zone.match?(/\A[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\z/i)

    expected = {
      "cloudflare_tunnel" => true,
      "cloudflare_ddns" => true,
      "ip_geo_enrichment" => true,
      "managed_default_vless" => true,
      "managed_default_ss2022" => false,
      "direct_docker" => false,
      "vless_port" => "automatic_preflight"
    }
    defaults = data["defaults"]
    fail "defaults must be a mapping" unless defaults.is_a?(Hash)
    fail "unknown defaults fields" unless (defaults.keys - expected.keys).empty?
    expected.each { |key, value| fail "defaults.#{key} must be #{value.inspect}" unless defaults[key] == value }

    overrides = data["node_overrides"]
    fail "node_overrides must be a mapping" unless overrides.is_a?(Hash)
    allowed = expected.keys - ["vless_port"]
    overrides.each do |name, override|
      fail "invalid node override name" unless name.is_a?(String) && name.match?(/\A[a-z0-9][a-z0-9-]*\z/)
      fail "override #{name} is not registered in hosts inventory" unless inventory.include?(name)
      fail "override #{name} must be a mapping" unless override.is_a?(Hash)
      fail "unknown override #{name} fields" unless (override.keys - %w[owner_approved reason defaults]).empty?
      fail "override #{name} is not owner-approved" unless override["owner_approved"] == true
      fail "override #{name} requires a reason" unless override["reason"].is_a?(String) && !override["reason"].strip.empty?
      values = override["defaults"] || {}
      fail "override #{name}.defaults must be a mapping" unless values.is_a?(Hash)
      unknown = values.keys - allowed
      fail "override #{name} has unknown defaults: #{unknown.join(", ")}" unless unknown.empty?
      values.each { |key, value| fail "override #{name}.#{key} must be boolean" unless value == true || value == false }
      private_docker = values["cloudflare_tunnel"] == false && values["managed_default_vless"] == false
      fail "override #{name} disables public endpoints without direct_docker" if private_docker && values["direct_docker"] != true
    end

    if host && !host.empty?
      values = defaults.merge((overrides.dig(host, "defaults") || {}))
      allowed.each { |key| puts "#{key}=#{values.fetch(key)}" }
      puts "public_hostname_zone=#{public_hostname_zone}"
    else
      puts "policy: OK"
    end
  ' "${POLICY_FILE}" "${host}" "${HOSTS_FILE}" || die "deployment policy is invalid"
}

cmd_policy() {
  local action="${1:-}"
  case "$action" in
    check) policy_values ;;
    *) die "usage: xp-infra policy check" ;;
  esac
}

cmd_port() {
  local action="${1:-}" host="${2:-}"
  [ "$action" = preflight ] && [ -n "$host" ] || die "usage: xp-infra port preflight <host>"
  [ "$#" -eq 2 ] || die "usage: xp-infra port preflight <host>"
  require_operator_account "$host"
  require_ruby_yaml

  local raw
  raw="$(port_preflight_ssh "$host" 'set -eu
echo XP_INFRA_PORT_PREFLIGHT=1 >/dev/null
env_file=/etc/xp/xp.env
container=""
MAX_PREFLIGHT_STATE_BYTES=32768
MAX_PREFLIGHT_DISCOVERY_BYTES=32768
PREFLIGHT_COMMAND_TIMEOUT_SECONDS=15
bounded_preflight_input() (
  output_file="$(mktemp)" || exit 1
  trap "rm -f \"$output_file\"" 0 HUP INT TERM
  dd iflag=fullblock bs="$((MAX_PREFLIGHT_DISCOVERY_BYTES + 1))" count=1 of="$output_file" 2>/dev/null || exit 1
  byte_count="$(wc -c < "$output_file" | tr -d "[:space:]")"
  case "$byte_count" in ""|*[!0-9]*) exit 1 ;; esac
  [ "$byte_count" -le "$MAX_PREFLIGHT_DISCOVERY_BYTES" ] || exit 1
  cat "$output_file"
)
bounded_preflight_command() (
  status_file="$(mktemp)" || exit 1
  trap "rm -f \"$status_file\"" 0 HUP INT TERM
  if (
    set +e
    timeout "$PREFLIGHT_COMMAND_TIMEOUT_SECONDS" "$@"
    command_status=$?
    printf "%s\n" "$command_status" > "$status_file"
  ) | bounded_preflight_input; then
    bounded_status=0
  else
    bounded_status=$?
  fi
  command_status="$(cat "$status_file" 2>/dev/null || true)"
  [ "$bounded_status" -eq 0 ] && [ "$command_status" = 0 ]
)
command -v timeout >/dev/null 2>&1 || exit 1
bounded_preflight_command sudo -n true >/dev/null || exit 1
host_env=false
host_env_status="$(bounded_preflight_command sudo -n sh -c '\''if [ -e "$1" ]; then [ -r "$1" ] || exit 1; printf %s readable; else printf %s absent; fi'\'' sh "$env_file" 2>/dev/null)" || exit 1
case "$host_env_status" in
  readable) host_env=true ;;
  absent) ;;
  *) exit 1 ;;
esac
host_env_snapshot=""
if [ "$host_env" = true ]; then
  host_env_snapshot="$(bounded_preflight_command sudo -n sh -c '\''env_file=$1; [ -r "$env_file" ] || exit 1; cat "$env_file"'\'' sh "$env_file" 2>/dev/null)" || exit 1
fi
host_env_value() {
  key="$1"
  printf '\''%s\n'\'' "$host_env_snapshot" | awk -v key="$key" '\''
    {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      sub(/^export[[:space:]]+/, "", line)
      split(line, pair, "=")
      if (pair[1] == key) {
        value = substr(line, index(line, "=") + 1)
        found = 1
      }
    }
    END { if (found) printf "%s", value }
  '\''
}
normalize_env_value() {
  value="$(printf "%s" "$1" | sed "s/^[[:space:]]*//;s/[[:space:]]*$//")"
  single_quote="$(printf "\\047")"
  case "$value" in
    \"*\") value="${value#\"}"; value="${value%\"}" ;;
    "$single_quote"*"$single_quote") value="${value#"$single_quote"}"; value="${value%"$single_quote"}" ;;
  esac
  printf %s "$value"
}
docker_path="$(bounded_preflight_command sudo -n sh -c '\''docker_path="$(command -v docker 2>/dev/null || true)"; for candidate in "$docker_path" /usr/bin/docker /usr/local/bin/docker; do if [ -n "$candidate" ] && [ -x "$candidate" ]; then printf %s "$candidate"; exit 0; fi; done; printf %s absent'\'' 2>/dev/null)" || exit 1
case "$docker_path" in
  absent|/*) ;;
  *) exit 1 ;;
esac
if [ "$docker_path" = absent ]; then
  docker_socket="$(bounded_preflight_command sudo -n sh -c '\''if [ -S /run/docker.sock ] || [ -S /var/run/docker.sock ]; then printf %s present; else printf %s absent; fi'\'' 2>/dev/null)" || exit 1
  [ "$docker_socket" = absent ] || exit 1
fi
containers=""
container_count=0
docker_inventory=""
if [ "$docker_path" != absent ]; then
  docker_inventory="$(bounded_preflight_command sudo -n "$docker_path" ps --format '\''{{.Names}} {{.Image}}'\'' 2>/dev/null)" || exit 1
  containers="$(printf '\''%s\n'\'' "$docker_inventory" | awk -v image_prefix="$XP_CONTAINER_IMAGE_PREFIX" '\''
    NF == 0 { next }
    NF != 2 || $1 !~ /^[A-Za-z0-9][A-Za-z0-9_.-]*$/ { exit 1 }
    index($2, image_prefix ":") == 1 || index($2, image_prefix "@") == 1 { print $1 }
  '\'')" || exit 1
  container_count="$(printf '\''%s\n'\'' "$containers" | awk '\''NF { count++ } END { print count + 0 }'\'')"
  [ "$container_count" -le 1 ] || exit 1
fi
if [ "$host_env" = true ] && [ "$container_count" -ne 0 ]; then
  exit 1
fi
xray_systemd_unit=xray
xray_openrc_service=xray
xray_api_addr=127.0.0.1:10085
state_path=""
legacy_state_path=""
state_selector=absent
if [ "$container_count" -eq 1 ]; then
  container="$containers"
  data_dir="$(bounded_preflight_command sudo -n "$docker_path" exec "$container" sh -c '\''if [ -n "${XP_DATA_DIR:-}" ]; then printf %s "$XP_DATA_DIR"; else printf %s /var/lib/xp/data; fi'\'' 2>/dev/null)" || exit 1
  xray_api_addr="$(bounded_preflight_command sudo -n "$docker_path" exec "$container" sh -c '\''printf %s "${XP_XRAY_API_ADDR:-127.0.0.1:10085}"'\'' 2>/dev/null)" || exit 1
  case "$data_dir" in /*) ;; *) exit 1 ;; esac
  state_path="$data_dir/managed-default-endpoints.json"
  legacy_state_path="$data_dir/container/managed_default_endpoints.json"
  state_selector=container
elif [ "$host_env" = true ]; then
  xray_systemd_unit="$(host_env_value XP_XRAY_SYSTEMD_UNIT)" || exit 1
  xray_openrc_service="$(host_env_value XP_XRAY_OPENRC_SERVICE)" || exit 1
  xray_api_addr="$(host_env_value XP_XRAY_API_ADDR)" || exit 1
  xray_systemd_unit="$(normalize_env_value "$xray_systemd_unit")"
  xray_openrc_service="$(normalize_env_value "$xray_openrc_service")"
  xray_api_addr="$(normalize_env_value "$xray_api_addr")"
  [ -n "$xray_systemd_unit" ] || xray_systemd_unit=xray
  [ -n "$xray_openrc_service" ] || xray_openrc_service=xray
  [ -n "$xray_api_addr" ] || xray_api_addr=127.0.0.1:10085
  case "$xray_systemd_unit" in *[!A-Za-z0-9_.@-]*) exit 1 ;; esac
  case "$xray_openrc_service" in *[!A-Za-z0-9_.-]*) exit 1 ;; esac
  data_dir="$(host_env_value XP_DATA_DIR)" || exit 1
  data_dir="$(normalize_env_value "$data_dir")"
  [ -n "$data_dir" ] || data_dir=/var/lib/xp/data
  case "$data_dir" in /*) ;; *) exit 1 ;; esac
  state_path="$data_dir/managed-default-endpoints.json"
  legacy_state_path="$data_dir/container/managed_default_endpoints.json"
  state_selector="$(bounded_preflight_command sudo -n sh -c '\''data_dir=$1; state_path=$2; legacy_state_path=$3; [ -d "$data_dir" ] && [ -r "$data_dir" ] && [ -x "$data_dir" ] || exit 1; if [ -e "$state_path" ]; then printf %s current; elif [ -e "$legacy_state_path" ]; then printf %s legacy; else printf %s absent; fi'\'' sh "$data_dir" "$state_path" "$legacy_state_path" 2>/dev/null)" || exit 1
fi
read_managed_state() {
  if [ "$container_count" -eq 1 ]; then
    bounded_preflight_command sudo -n "$docker_path" exec "$container" sh -c '\''path=$1; legacy_path=$2; limit=$3; if [ -e "$path" ]; then dd if="$path" bs="$((limit + 1))" count=1 2>/dev/null; elif [ -e "$legacy_path" ]; then dd if="$legacy_path" bs="$((limit + 1))" count=1 2>/dev/null; else printf %s "{}"; fi'\'' sh "$state_path" "$legacy_state_path" "$MAX_PREFLIGHT_STATE_BYTES"
    return
  fi
  case "$state_selector" in
    current) bounded_preflight_command sudo -n dd if="$state_path" bs="$((MAX_PREFLIGHT_STATE_BYTES + 1))" count=1 2>/dev/null ;;
    legacy) bounded_preflight_command sudo -n dd if="$legacy_state_path" bs="$((MAX_PREFLIGHT_STATE_BYTES + 1))" count=1 2>/dev/null ;;
    absent) printf %s '{}' ;;
    *) return 1 ;;
  esac
}
state="$(read_managed_state)" || exit 1
case "$xray_api_addr" in
  127.*:*)
    xray_api_host="${xray_api_addr%:*}"
    old_ifs="$IFS"
    IFS=.
    set -- $xray_api_host
    IFS="$old_ifs"
    [ "$#" -eq 4 ] || exit 1
    for octet in "$@"; do
      case "$octet" in
        [0-9]|[0-9][0-9]|[0-9][0-9][0-9]) ;;
        *) exit 1 ;;
      esac
      [ "$octet" -le 255 ] || exit 1
    done
    ;;
  \[::1\]:*) ;;
  *) exit 1 ;;
esac
xray_api_port="${xray_api_addr##*:}"
[ "$xray_api_port" -ge 1 ] && [ "$xray_api_port" -le 65535 ] || exit 1
[ "$(printf '\''%s'\'' "$state" | wc -c | tr -d '\''[:space:]'\'')" -le "$MAX_PREFLIGHT_STATE_BYTES" ] || exit 1
printf '\''state_b64=%s\n'\'' "$(printf '\''%s'\'' "$state" | base64 | tr -d '\''\r\n'\'')"

collect_host_listeners() {
  if command -v ss >/dev/null 2>&1; then
    bounded_preflight_command sudo -n ss -H -ltnp 2>/dev/null
  elif command -v netstat >/dev/null 2>&1; then
    bounded_preflight_command sudo -n netstat -ltnp 2>/dev/null
  else
    return 1
  fi
}
host_listeners="$(collect_host_listeners)" || exit 1
runtime_listeners="$host_listeners"
collect_published_ports() {
  published_ports=""
  if [ "$docker_path" != absent ]; then
    docker_ids="$(bounded_preflight_command sudo -n "$docker_path" ps -q 2>/dev/null)" || return 1
    for docker_id in $docker_ids; do
      container_ports="$(bounded_preflight_command sudo -n "$docker_path" port "$docker_id" 2>/dev/null)" || return 1
      container_published_ports="$(printf '\''%s\n'\'' "$container_ports" | awk -v max="$MAX_PREFLIGHT_DISCOVERY_BYTES" '\''
        function emit(port) {
          value = port "\n"
          if (bytes + length(value) > max) { invalid = 1; return }
          print port
          bytes += length(value)
        }
        NF == 0 { next }
        {
          value = $NF
          sub(/^.*:/, "", value)
          count = split(value, bounds, "-")
          if (count < 1 || count > 2 || bounds[1] !~ /^[1-9][0-9]*$/ || (count == 2 && bounds[2] !~ /^[1-9][0-9]*$/)) { invalid = 1; next }
          first = bounds[1] + 0
          last = count == 2 ? bounds[2] + 0 : first
          if (first > 65535 || last > 65535 || last < first) { invalid = 1; next }
          for (port = first; port <= last; port++) { emit(port); if (invalid) exit 1 }
        }
        END { if (invalid) exit 1 }
      '\'')" || return 1
      published_ports="${published_ports}
${container_published_ports}"
      [ "$(printf '\''%s'\'' "$published_ports" | wc -c | tr -d "[:space:]")" -le "$MAX_PREFLIGHT_DISCOVERY_BYTES" ] || return 1
    done
  fi
  printf '%s' "$published_ports"
}
published_ports="$(collect_published_ports)" || exit 1
collect_runtime_listeners() {
  if [ -n "$container" ]; then
    if bounded_preflight_command sudo -n "$docker_path" exec "$container" sh -c '\''command -v ss >/dev/null 2>&1'\''; then bounded_preflight_command sudo -n "$docker_path" exec "$container" ss -H -ltnp
    elif bounded_preflight_command sudo -n "$docker_path" exec "$container" sh -c '\''command -v netstat >/dev/null 2>&1'\''; then bounded_preflight_command sudo -n "$docker_path" exec "$container" netstat -ltnp
    else return 1
    fi
  else
    printf '%s' "$host_listeners"
  fi
}
runtime_listeners="$(collect_runtime_listeners)" || exit 1
listener_ports="$(printf '\''%s\n%s\n%s\n'\'' "$host_listeners" "$runtime_listeners" "$published_ports" | awk '\''
  function add_port(port) { seen[port] = 1 }
  /^[1-9][0-9]*$/ { if ($1 <= 65535) add_port($1); next }
  NF == 0 || /^(Proto|Active)[[:space:]]/ { next }
  NF < 4 { invalid = 1; next }
  { value=$4; sub(/^.*:/, "", value); if (value !~ /^[1-9][0-9]*$/ || value > 65535) { invalid = 1; next }; add_port(value) }
  END {
    if (invalid) exit 1
    output = ""
    for (port in seen) output = output (output ? "," : "") port
    print output
  }
'\'')" || exit 1
printf '\''occupied_ports=%s\n'\'' "$listener_ports"
printf '\''xray_ports=%s\n'\'' "$(printf '\''%s\n'\'' "$runtime_listeners" | awk '\''/users:\(\("xray",pid=[0-9]+/ || /(^|[[:space:]])[0-9]+\/xray([[:space:]]|$)/ { value=$4; if (value ~ /^127\./ || value ~ /^\[?::1\]?:/ || value ~ /^\[?::ffff:127\./) next; sub(/^.*:/, "", value); if (value ~ /^[1-9][0-9]*$/ && value <= 65535 && !seen[value]++) print value }'\'' | sort -n | paste -sd, -)"
printf '\''xray_listener_pids=%s\n'\'' "$(printf '\''%s\n'\'' "$runtime_listeners" | awk '\''
  /users:\(\("xray",pid=[0-9]+/ {
    value = $0
    sub(/^.*users:\(\("xray",pid=/, "", value)
    sub(/[^0-9].*$/, "", value)
    if (value ~ /^[1-9][0-9]*$/ && !seen[value]++) print value
    next
  }
  /(^|[[:space:]])[1-9][0-9]*\/xray([[:space:]]|$)/ {
    for (field = 1; field <= NF; field++) {
      if ($field ~ /^[1-9][0-9]*\/xray$/) {
        split($field, parts, "/")
        if (!seen[parts[1]]++) print parts[1]
        break
      }
    }
  }
'\'' | sort -n | paste -sd, -)"
read_xray_pid() {
  if [ -n "$container" ]; then
    bounded_preflight_command sudo -n "$docker_path" exec "$container" sh -c '\''if pid_output=$(pidof xray 2>/dev/null); then set -- $pid_output; [ "$#" -eq 1 ] || exit 1; printf %s "$1"; else status=$?; [ "$status" -eq 1 ] || exit "$status"; fi'\'' 2>/dev/null
  else
    bounded_preflight_command sudo -n sh -c '\''if pid_output=$(pidof xray 2>/dev/null); then set -- $pid_output; [ "$#" -eq 1 ] || exit 1; printf %s "$1"; else status=$?; [ "$status" -eq 1 ] || exit "$status"; fi'\'' 2>/dev/null
  fi
}
read_ephemeral_range() {
  if [ -n "$container" ]; then
    bounded_preflight_command sudo -n "$docker_path" exec "$container" sh -c '\''sysctl -n net.ipv4.ip_local_port_range 2>/dev/null || cat /proc/sys/net/ipv4/ip_local_port_range'\'' 2>/dev/null
  else
    bounded_preflight_command sudo -n sh -c '\''sysctl -n net.ipv4.ip_local_port_range 2>/dev/null || cat /proc/sys/net/ipv4/ip_local_port_range'\'' 2>/dev/null
  fi
}
read_reserved_ports() {
  if [ -n "$container" ]; then
    bounded_preflight_command sudo -n "$docker_path" exec "$container" sh -c '\''sysctl -n net.ipv4.ip_local_reserved_ports 2>/dev/null || cat /proc/sys/net/ipv4/ip_local_reserved_ports'\'' 2>/dev/null
  else
    bounded_preflight_command sudo -n sh -c '\''sysctl -n net.ipv4.ip_local_reserved_ports 2>/dev/null || cat /proc/sys/net/ipv4/ip_local_reserved_ports'\'' 2>/dev/null
  fi
}
read_unprivileged_port_start() {
  if [ -n "$container" ]; then
    bounded_preflight_command sudo -n "$docker_path" exec "$container" sh -c '\''sysctl -n net.ipv4.ip_unprivileged_port_start 2>/dev/null || cat /proc/sys/net/ipv4/ip_unprivileged_port_start'\'' 2>/dev/null
  else
    bounded_preflight_command sudo -n sh -c '\''sysctl -n net.ipv4.ip_unprivileged_port_start 2>/dev/null || cat /proc/sys/net/ipv4/ip_unprivileged_port_start'\'' 2>/dev/null
  fi
}
read_xray_api() {
  [ -n "$xray_runtime_pid" ] || return 0
  if [ -n "$container" ]; then
    bounded_preflight_command sudo -n "$docker_path" exec "$container" xray api lsi --server="$xray_api_addr" --isOnlyTags=false 2>/dev/null
  else
    bounded_preflight_command sudo -n xray api lsi --server="$xray_api_addr" --isOnlyTags=false 2>/dev/null
  fi
}
read_xray_process_security() {
  [ -n "$xray_runtime_pid" ] || { printf '%s' unavailable; return 0; }
  if [ -n "$container" ]; then
    bounded_preflight_command sudo -n "$docker_path" exec "$container" awk '\''/^Uid:/{uid=$3}/^CapEff:/{cap=$2}END{if(uid=="" || cap=="")exit 1; print uid,cap}'\'' "/proc/$xray_runtime_pid/status" 2>/dev/null
  else
    bounded_preflight_command sudo -n awk '\''/^Uid:/{uid=$3}/^CapEff:/{cap=$2}END{if(uid=="" || cap=="")exit 1; print uid,cap}'\'' "/proc/$xray_runtime_pid/status" 2>/dev/null
  fi
}
revalidate_host_service() {
  [ -n "$container" ] && return 0
  [ -n "$xray_runtime_pid" ] || return 0
  if command -v systemctl >/dev/null 2>&1 && bounded_preflight_command sudo -n systemctl is-active --quiet "$xray_systemd_unit" >/dev/null; then
    [ "$xray_service" = active ] || return 1
    xray_service_pid_after="$(bounded_preflight_command sudo -n systemctl show --property MainPID --value "$xray_systemd_unit" 2>/dev/null)" || return 1
    [ "$xray_service_pid_after" = "$xray_service_pid" ] || return 1
    return 0
  fi
  if command -v rc-service >/dev/null 2>&1 && bounded_preflight_command sudo -n rc-service "$xray_openrc_service" status >/dev/null; then
    [ "$xray_service" = active ] || return 1
    xray_pidfile_after="$(bounded_preflight_command sudo -n sh -c '\''service=$1; for candidate in "/run/supervise-$service.pid" "/var/run/supervise-$service.pid" "/run/$service.pid" "/var/run/$service.pid"; do if [ -r "$candidate" ]; then printf %s "$candidate"; exit 0; fi; done; exit 1'\'' sh "$xray_openrc_service" 2>/dev/null)" || return 1
    [ "$xray_pidfile_after" = "$xray_pidfile" ] || return 1
    xray_service_pid_after="$(bounded_preflight_command sudo -n cat "$xray_pidfile_after" 2>/dev/null)" || return 1
    [ "$xray_service_pid_after" = "$xray_service_pid" ] || return 1
    return 0
  fi
  return 1
}
if [ -n "$container" ]; then
  ephemeral_range="$(read_ephemeral_range)" || exit 1
  reserved_ports="$(read_reserved_ports)" || exit 1
  unprivileged_port_start="$(read_unprivileged_port_start)" || exit 1
  xray_runtime_pid="$(read_xray_pid)" || exit 1
  xray_api_json="$(read_xray_api)" || exit 1
  if [ -n "$xray_runtime_pid" ]; then
    xray_security="$(read_xray_process_security)" || exit 1
  else
    xray_security=unavailable
  fi
  if [ "$xray_security" = unavailable ]; then
    container_user_raw="$(bounded_preflight_command sudo -n "$docker_path" inspect --format '\''{{.Config.User}}'\'' "$container" 2>/dev/null)" || exit 1
    container_cap_drop="$(bounded_preflight_command sudo -n "$docker_path" inspect --format '\''{{json .HostConfig.CapDrop}}'\'' "$container" 2>/dev/null)" || exit 1
    container_cap_add="$(bounded_preflight_command sudo -n "$docker_path" inspect --format '\''{{json .HostConfig.CapAdd}}'\'' "$container" 2>/dev/null)" || exit 1
    container_capability=0
    case "$container_cap_add" in *NET_BIND_SERVICE*) container_capability=0000000000000400 ;; esac
    container_user="$container_user_raw"
    container_user="${container_user%%:*}"
    if [ -z "$container_user" ] || [ "$container_user" = root ] || [ "$container_user" = 0 ]; then
      case "$container_cap_drop" in
        *ALL*|*NET_BIND_SERVICE*) [ "$container_capability" != 0 ] || container_capability=0 ;;
        *) [ "$container_capability" != 0 ] || container_capability=0000000000000400 ;;
      esac
      xray_security="0 $container_capability"
    else
      case "$container_user" in
        *[!0-9]*) container_user="$(bounded_preflight_command sudo -n "$docker_path" exec "$container" id -u "$container_user" 2>/dev/null)" || exit 1 ;;
      esac
      case "$container_user" in [1-9][0-9]*) xray_security="$container_user $container_capability" ;; *) exit 1 ;; esac
    fi
  fi
  if [ -n "$xray_runtime_pid" ]; then xray_service=active; else xray_service=inactive; fi
else
  ephemeral_range="$(read_ephemeral_range)" || exit 1
  reserved_ports="$(read_reserved_ports)" || exit 1
  unprivileged_port_start="$(read_unprivileged_port_start)" || exit 1
  xray_runtime_pid="$(read_xray_pid)" || exit 1
  xray_api_json="$(read_xray_api)" || exit 1
  if [ -n "$xray_runtime_pid" ]; then
    xray_security="$(read_xray_process_security)" || exit 1
  else
    xray_security='\''unavailable'\''
  fi
  if [ -n "$xray_runtime_pid" ]; then
    xray_service=inactive
    xray_service_pid=""
    if command -v systemctl >/dev/null 2>&1 && bounded_preflight_command sudo -n systemctl is-active --quiet "$xray_systemd_unit" >/dev/null; then
      xray_service_pid="$(bounded_preflight_command sudo -n systemctl show --property MainPID --value "$xray_systemd_unit" 2>/dev/null)" || exit 1
      xray_service=active
      [ "$xray_service_pid" = "$xray_runtime_pid" ] || exit 1
    elif command -v rc-service >/dev/null 2>&1 && bounded_preflight_command sudo -n rc-service "$xray_openrc_service" status >/dev/null; then
      xray_pidfile="$(bounded_preflight_command sudo -n sh -c '\''service=$1; for candidate in "/run/supervise-$service.pid" "/var/run/supervise-$service.pid" "/run/$service.pid" "/var/run/$service.pid"; do if [ -r "$candidate" ]; then printf %s "$candidate"; exit 0; fi; done; exit 1'\'' sh "$xray_openrc_service" 2>/dev/null)" || exit 1
      xray_service_pid="$(bounded_preflight_command sudo -n cat "$xray_pidfile" 2>/dev/null)" || exit 1
      [ -n "$xray_service_pid" ] || exit 1
      case "$xray_service_pid" in *[!0-9]*) exit 1 ;; esac
      if [ "$xray_service_pid" != "$xray_runtime_pid" ]; then
        xray_supervisor_cmd="$(bounded_preflight_command sudo -n sh -c '\''tr "\\000" " " < "/proc/$1/cmdline"'\'' sh "$xray_service_pid" 2>/dev/null)" || exit 1
        case " $xray_supervisor_cmd " in
          *" supervise-daemon $xray_openrc_service "*|*" /supervise-daemon $xray_openrc_service "*) ;;
          *) exit 1 ;;
        esac
        xray_parent_pid="$(bounded_preflight_command sudo -n sh -c '\''stat_file="/proc/$1/stat"; [ -r "$stat_file" ] || exit 1; line=$(cat "$stat_file") || exit 1; line=${line#*) }; set -- $line; printf %s "${2:-}"'\'' sh "$xray_runtime_pid" 2>/dev/null)" || exit 1
        [ -n "$xray_parent_pid" ] || exit 1
        case "$xray_parent_pid" in *[!0-9]*) exit 1 ;; esac
        [ "$xray_parent_pid" = "$xray_service_pid" ] || exit 1
      fi
      xray_service=active
    fi
    [ "$xray_service" = active ] || exit 1
  else
    xray_service=inactive
  fi
fi
host_env_status_after="$(bounded_preflight_command sudo -n sh -c '\''if [ -e "$1" ]; then [ -r "$1" ] || exit 1; printf %s readable; else printf %s absent; fi'\'' sh "$env_file" 2>/dev/null)" || exit 1
[ "$host_env_status_after" = "$host_env_status" ] || exit 1
if [ "$host_env" = true ]; then
  host_env_snapshot_after="$(bounded_preflight_command sudo -n sh -c '\''env_file=$1; [ -r "$env_file" ] || exit 1; cat "$env_file"'\'' sh "$env_file" 2>/dev/null)" || exit 1
  [ "$host_env_snapshot_after" = "$host_env_snapshot" ] || exit 1
  state_selector_after="$(bounded_preflight_command sudo -n sh -c '\''data_dir=$1; state_path=$2; legacy_state_path=$3; [ -d "$data_dir" ] && [ -r "$data_dir" ] && [ -x "$data_dir" ] || exit 1; if [ -e "$state_path" ]; then printf %s current; elif [ -e "$legacy_state_path" ]; then printf %s legacy; else printf %s absent; fi'\'' sh "$data_dir" "$state_path" "$legacy_state_path" 2>/dev/null)" || exit 1
  [ "$state_selector_after" = "$state_selector" ] || exit 1
fi
docker_path_after="$(bounded_preflight_command sudo -n sh -c '\''docker_path="$(command -v docker 2>/dev/null || true)"; for candidate in "$docker_path" /usr/bin/docker /usr/local/bin/docker; do if [ -n "$candidate" ] && [ -x "$candidate" ]; then printf %s "$candidate"; exit 0; fi; done; printf %s absent'\'' 2>/dev/null)" || exit 1
[ "$docker_path_after" = "$docker_path" ] || exit 1
if [ "$docker_path" = absent ]; then
  docker_socket_after="$(bounded_preflight_command sudo -n sh -c '\''if [ -S /run/docker.sock ] || [ -S /var/run/docker.sock ]; then printf %s present; else printf %s absent; fi'\'' 2>/dev/null)" || exit 1
  [ "$docker_socket_after" = "$docker_socket" ] || exit 1
else
  docker_inventory_after="$(bounded_preflight_command sudo -n "$docker_path" ps --format '\''{{.Names}} {{.Image}}'\'' 2>/dev/null)" || exit 1
  [ "$docker_inventory_after" = "$docker_inventory" ] || exit 1
  containers_after="$(printf '\''%s\n'\'' "$docker_inventory_after" | awk -v image_prefix="$XP_CONTAINER_IMAGE_PREFIX" '\''
    NF == 0 { next }
    NF != 2 || $1 !~ /^[A-Za-z0-9][A-Za-z0-9_.-]*$/ { exit 1 }
    index($2, image_prefix ":") == 1 || index($2, image_prefix "@") == 1 { print $1 }
  '\'')" || exit 1
  container_count_after="$(printf '\''%s\n'\'' "$containers_after" | awk '\''NF { count++ } END { print count + 0 }'\'')"
  [ "$container_count_after" -le 1 ] || exit 1
  [ "$containers_after" = "$containers" ] || exit 1
  [ "$container_count_after" = "$container_count" ] || exit 1
fi
state_after="$(read_managed_state)" || exit 1
[ "$(printf '\''%s'\'' "$state_after" | wc -c | tr -d '\''[:space:]'\'')" -le "$MAX_PREFLIGHT_STATE_BYTES" ] || exit 1
[ "$state_after" = "$state" ] || exit 1
published_ports_after="$(collect_published_ports)" || exit 1
[ "$published_ports_after" = "$published_ports" ] || exit 1
ephemeral_range_after="$(read_ephemeral_range)" || exit 1
reserved_ports_after="$(read_reserved_ports)" || exit 1
unprivileged_port_start_after="$(read_unprivileged_port_start)" || exit 1
[ "$ephemeral_range_after" = "$ephemeral_range" ] || exit 1
[ "$reserved_ports_after" = "$reserved_ports" ] || exit 1
[ "$unprivileged_port_start_after" = "$unprivileged_port_start" ] || exit 1
host_listeners_after="$(collect_host_listeners)" || exit 1
[ "$host_listeners_after" = "$host_listeners" ] || exit 1
runtime_listeners_after="$(collect_runtime_listeners)" || exit 1
[ "$runtime_listeners_after" = "$runtime_listeners" ] || exit 1
xray_runtime_pid_after="$(read_xray_pid)" || exit 1
[ "$xray_runtime_pid_after" = "$xray_runtime_pid" ] || exit 1
xray_api_json_after="$(read_xray_api)" || exit 1
[ "$xray_api_json_after" = "$xray_api_json" ] || exit 1
if [ -n "$xray_runtime_pid" ]; then
  xray_security_after="$(read_xray_process_security)" || exit 1
  [ "$xray_security_after" = "$xray_security" ] || exit 1
elif [ -n "$container" ]; then
  container_user_after="$(bounded_preflight_command sudo -n "$docker_path" inspect --format '\''{{.Config.User}}'\'' "$container" 2>/dev/null)" || exit 1
  container_cap_drop_after="$(bounded_preflight_command sudo -n "$docker_path" inspect --format '\''{{json .HostConfig.CapDrop}}'\'' "$container" 2>/dev/null)" || exit 1
  container_cap_add_after="$(bounded_preflight_command sudo -n "$docker_path" inspect --format '\''{{json .HostConfig.CapAdd}}'\'' "$container" 2>/dev/null)" || exit 1
  [ "$container_user_after" = "$container_user_raw" ] || exit 1
  [ "$container_cap_drop_after" = "$container_cap_drop" ] || exit 1
  [ "$container_cap_add_after" = "$container_cap_add" ] || exit 1
fi
revalidate_host_service || exit 1
printf '\''ephemeral_range=%s\n'\'' "$ephemeral_range"
printf '\''reserved_ports=%s\n'\'' "$reserved_ports"
printf '\''unprivileged_port_start=%s\n'\'' "$unprivileged_port_start"
printf '\''xray_runtime_pid=%s\n'\'' "$xray_runtime_pid"
printf '\''xray_service=%s\n'\'' "$xray_service"
printf '\''xray_security=%s\n'\'' "$xray_security"
printf '\''xray_api_b64=%s\n'\'' "$(printf '\''%s'\'' "$xray_api_json" | base64 | tr -d '\''\r\n'\'')"
' | bounded_audit_output)" || die "automatic VLESS port preflight could not read ${host} runtime state"

  printf '%s\n' "$raw" | ruby -rbase64 -rjson -rdigest -ripaddr -e '
    host = ARGV.fetch(0)
    values = STDIN.each_line.each_with_object({}) do |line, result|
      key, value = line.chomp.split("=", 2)
      abort "invalid preflight collector record" unless key && value && key.match?(/\A[a-z0-9_]+\z/) && !result.key?(key)
      result[key] = value
    end
    class DuplicateJsonMember < StandardError; end
    class DuplicateRejectingHash < Hash
      def []=(key, value)
        raise DuplicateJsonMember if key?(key)

        super
      end
    end
    state = JSON.parse(Base64.strict_decode64(values.fetch("state_b64")), object_class: DuplicateRejectingHash)
    abort "managed endpoint state must be an object" unless state.is_a?(Hash)
    if state.empty?
      managed = false
    else
      abort "unsupported managed endpoint state schema" unless state["schema_version"] == 1 && state.key?("vless_endpoint_id")
      endpoint_id = state["vless_endpoint_id"]
      abort "invalid managed VLESS endpoint identity" unless endpoint_id.nil? || (endpoint_id.is_a?(String) && !endpoint_id.empty?)
      managed = !endpoint_id.nil?
    end
    ports = ->(key) do
      values.fetch(key, "").split(",").reject(&:empty?).map { |value| Integer(value, 10) }
        .select { |value| value.between?(1, 65_535) }.uniq
    end
    pids = ->(key) do
      values.fetch(key, "").split(",").reject(&:empty?).map { |value| Integer(value, 10) }
        .select(&:positive?).uniq
    end
    xray = ports.call("xray_ports")
    xray_listener_pids = pids.call("xray_listener_pids")
    xray_runtime_pid = values.fetch("xray_runtime_pid", "")
    xray_service = values.fetch("xray_service", "")
    xray_api_b64 = values.fetch("xray_api_b64", "")
    read_varint = lambda do |bytes, offset|
      value = 0
      shift = 0
      loop do
        abort "invalid Xray API protobuf" if offset >= bytes.bytesize || shift > 63
        byte = bytes.getbyte(offset)
        offset += 1
        value |= (byte & 0x7f) << shift
        return [value, offset] if (byte & 0x80).zero?

        shift += 7
      end
    end
    read_fields = lambda do |bytes|
      fields = []
      offset = 0
      while offset < bytes.bytesize
        key, offset = read_varint.call(bytes, offset)
        field_number = key >> 3
        wire_type = key & 0x07
        abort "invalid Xray API protobuf" if field_number.zero?
        case wire_type
        when 0
          value, offset = read_varint.call(bytes, offset)
          fields << [field_number, wire_type, value]
        when 2
          length, offset = read_varint.call(bytes, offset)
          finish = offset + length
          abort "invalid Xray API protobuf" if finish > bytes.bytesize
          fields << [field_number, wire_type, bytes.byteslice(offset, length)]
          offset = finish
        else
          abort "unsupported Xray API protobuf wire type"
        end
      end
      fields
    end
    xray_inbound_port = lambda do |inbound|
      typed = inbound["receiverSettings"] || inbound["receiver_settings"]
      abort "managed VLESS endpoint has invalid Xray receiver settings" unless typed.is_a?(Hash)
      typed_name = typed["type"] || typed["_TypedMessage_"]
      abort "managed VLESS endpoint has invalid Xray receiver settings" unless typed_name == "xray.app.proxyman.ReceiverConfig"
      if typed.key?("portList")
        port = typed["portList"]
        abort "managed VLESS endpoint has invalid Xray receiver settings" unless port.is_a?(Integer) && port.between?(1, 65_535)
        return port
      end
      encoded_value = typed["value"]
      abort "managed VLESS endpoint has invalid Xray receiver settings" unless encoded_value.is_a?(String) && !encoded_value.empty?
      receiver_fields = read_fields.call(Base64.strict_decode64(encoded_value))
      port_list_values = receiver_fields.select { |field, wire, _| field == 1 && wire == 2 }.map(&:last)
      abort "managed VLESS endpoint has invalid Xray receiver settings" unless port_list_values.length == 1
      range_values = read_fields.call(port_list_values.first).select { |field, wire, _| field == 1 && wire == 2 }.map(&:last)
      abort "managed VLESS endpoint has invalid Xray receiver settings" if range_values.empty?
      ports = range_values.map do |range_value|
        range_fields = read_fields.call(range_value)
        from_values = range_fields.select { |field, wire, _| field == 1 && wire == 0 }.map(&:last)
        to_values = range_fields.select { |field, wire, _| field == 2 && wire == 0 }.map(&:last)
        abort "managed VLESS endpoint has invalid Xray receiver settings" unless from_values.length == 1 && to_values.length == 1 && from_values.first == to_values.first
        from_values.first
      end
      abort "managed VLESS endpoint has invalid Xray receiver settings" unless ports.length == 1
      ports.first
    end
    abort "invalid Xray runtime PID" unless xray_runtime_pid.empty? || xray_runtime_pid.match?(/\A[1-9][0-9]*\z/)
    if managed
      abort "managed VLESS endpoint requires exactly one active public Xray listener" unless xray.length == 1
      abort "managed VLESS endpoint requires one verified Xray listener process" unless xray_listener_pids.length == 1 && xray_runtime_pid == xray_listener_pids.first.to_s
      abort "managed VLESS endpoint requires the target Xray service" unless xray_service == "active"
      abort "managed VLESS endpoint requires a readable Xray API inventory" if xray_api_b64.empty?
      begin
        api = JSON.parse(Base64.strict_decode64(xray_api_b64))
      rescue ArgumentError, JSON::ParserError
        abort "managed VLESS endpoint has invalid Xray API inventory"
      end
      inbounds = api.is_a?(Hash) ? api["inbounds"] : api
      abort "managed VLESS endpoint has invalid Xray API inventory" unless inbounds.is_a?(Array)
      managed_tag = "vless-vision-#{endpoint_id}"
      managed_inbounds = inbounds.select { |inbound| inbound.is_a?(Hash) && inbound["tag"] == managed_tag }
      abort "managed VLESS endpoint is absent from the Xray API inventory" unless managed_inbounds.length == 1
      managed_port = xray_inbound_port.call(managed_inbounds.first)
      abort "managed VLESS endpoint has an invalid Xray API port" unless managed_port.is_a?(Integer) && managed_port.between?(1, 65_535)
      abort "managed VLESS endpoint listener is not owned by its Xray inbound" unless managed_port == xray.first
      puts xray.first
      exit
    end
    abort "public Xray listener exists without managed VLESS endpoint state" unless xray.empty?
    occupied = ports.call("occupied_ports").to_h { |value| [value, true] }
    ephemeral_bounds = values.fetch("ephemeral_range").split.map { |value| Integer(value, 10) }
    abort "invalid kernel ephemeral port range" unless ephemeral_bounds.length == 2 && ephemeral_bounds[0].between?(1, 65_535) && ephemeral_bounds[1].between?(ephemeral_bounds[0], 65_535)
    unavailable = occupied
    (ephemeral_bounds[0]..ephemeral_bounds[1]).each { |port| unavailable[port] = true }
    values.fetch("reserved_ports").split(",").reject(&:empty?).each do |entry|
      bounds = entry.split("-", 2).map { |value| Integer(value, 10) }
      bounds << bounds[0] if bounds.length == 1
      abort "invalid kernel reserved port range" unless bounds.length == 2 && bounds[0].between?(1, 65_535) && bounds[1].between?(bounds[0], 65_535)
      (bounds[0]..bounds[1]).each { |port| unavailable[port] = true }
    end
    unprivileged_start = Integer(values.fetch("unprivileged_port_start"), 10)
    abort "invalid kernel unprivileged port start" unless unprivileged_start.between?(0, 65_535)
    security = values.fetch("xray_security")
    can_bind_privileged = if security == "unavailable"
      false
    else
      uid_text, capability_text = security.split
      abort "invalid Xray security record" unless security.split.length == 2 && uid_text.match?(/\A(?:0|[1-9][0-9]*)\z/) && capability_text.match?(/\A[0-9a-fA-F]+\z/)
      effective_capabilities = Integer(capability_text, 16)
      (effective_capabilities & (1 << 10)) != 0
    end
    candidate_start = can_bind_privileged ? 1 : [unprivileged_start, 1].max
    candidates = (candidate_start..65_535).reject { |port| unavailable[port] }
    abort "no bindable VLESS bootstrap port" if candidates.empty?
    offset = Digest::SHA256.hexdigest(host)[0, 8].to_i(16) % candidates.length
    candidates.length.times do |step|
      candidate = candidates[(offset + step) % candidates.length]
      unless unavailable[candidate]
        puts candidate
        exit
      end
    end
    abort "no bindable VLESS bootstrap port"
  ' "$host" || die "automatic VLESS port preflight failed for ${host}"
}

read_audit_result() {
  local host="$1" allow_direct_docker="$2" require_xray_public_listener="$3"
  require_operator_account "$host"
  [ -x "${AUDIT_REMOTE_SCRIPT}" ] || die "missing audit probe: ${AUDIT_REMOTE_SCRIPT}"
  case "$allow_direct_docker" in true|false) ;; *) die "audit policy has an invalid direct Docker setting" ;; esac
  case "$require_xray_public_listener" in true|false) ;; *) die "audit policy has an invalid Xray listener setting" ;; esac
  ssh \
    -o BatchMode=yes \
    -o ConnectTimeout="${SSH_CONNECT_TIMEOUT_SECS}" \
    "$host" "sh -s -- '${allow_direct_docker}' '${require_xray_public_listener}'" < "${AUDIT_REMOTE_SCRIPT}"
}


read_vless_audit_result() {
  local host="$1" access_host="$2" vless_port="$3" allow_direct_docker="$4" runtime_mode="$5" container_identity="$6" container_started_at="$7" host_xray_pid="$8" host_xray_starttime="$9" container_xray_token="${10}"
  [ -x "${AUDIT_VLESS_REMOTE_SCRIPT}" ] || die "missing VLESS audit probe: ${AUDIT_VLESS_REMOTE_SCRIPT}"
  case "$access_host" in ''|*[!A-Za-z0-9.-]*) die "audit returned an unsafe VLESS access host" ;; esac
  case "$vless_port" in ''|*[!0-9]*) die "audit returned an invalid VLESS port" ;; esac
  case "$allow_direct_docker" in true|false) ;; *) die "audit policy has an invalid direct Docker setting" ;; esac
  case "$runtime_mode" in
    host)
      [ -z "$container_identity" ] && [ -z "$container_started_at" ] && [ -z "$container_xray_token" ] || die "audit returned an invalid host runtime snapshot"
      [[ "$host_xray_pid" =~ ^[1-9][0-9]*$ ]] || die "audit returned an invalid host Xray PID"
      [[ "$host_xray_starttime" =~ ^[1-9][0-9]*$ ]] || die "audit returned an invalid host Xray start time"
      ;;
    container)
      [[ "$container_identity" =~ ^[0-9a-f]{64}$ ]] || die "audit returned an invalid container identity"
      [[ "$container_started_at" =~ ^[0-9TZ:.-]+$ ]] || die "audit returned an invalid container start time"
      [ -z "$host_xray_pid" ] && [ -z "$host_xray_starttime" ] || die "audit returned an invalid container host identity"
      [[ "$container_xray_token" =~ ^[1-9][0-9]*:[1-9][0-9]*$ ]] || die "audit returned an invalid container Xray identity"
      ;;
    *) die "audit returned an invalid runtime mode" ;;
  esac
  ssh \
    -o BatchMode=yes \
    -o ConnectTimeout="${SSH_CONNECT_TIMEOUT_SECS}" \
    "$host" "sh -s -- '${access_host}' '${vless_port}' '${allow_direct_docker}' '${runtime_mode}' '${container_identity}' '${container_started_at}' '${host_xray_pid}' '${host_xray_starttime}' '${container_xray_token}'" < "${AUDIT_VLESS_REMOTE_SCRIPT}"
}

normalize_audit_result() {
  local mode="$1" raw="$2"
  [ -x "${AUDIT_LOCAL_SCRIPT}" ] || die "missing local audit parser: ${AUDIT_LOCAL_SCRIPT}"
  printf '%s\n' "$raw" | "${AUDIT_LOCAL_SCRIPT}" "$mode"
}

cmd_audit() {
  local host="${1:-}"
  [ -n "$host" ] || die "missing <host>"
  require_registered_host "$host"
  shift || true
  [ "$#" -eq 0 ] || die "usage: xp-infra audit <host>"
  command -v curl >/dev/null 2>&1 || die "curl is required for operator-side public probes"

  local expected raw basic_raw key value failed=0
  local want_cloudflare_tunnel="" want_cloudflare_ddns="" want_ip_geo_enrichment=""
  local want_managed_default_vless="" want_managed_default_ss2022="" allow_direct_docker="" public_hostname_zone=""
  local got_xp_service="" got_xray_service="" got_cloudflared_service=""
  local got_cloudflare_tunnel="" got_cloudflare_ddns_enabled="" got_cloudflare_ddns="" got_ip_geo_enrichment=""
  local got_managed_default_vless="" got_managed_default_ss2022=""
  local got_canary_enabled="" got_canary_certificate="" got_local_health="" got_xray_runtime=""
  local got_local_canary="" got_vless_ingress="" got_public_health="" got_cluster_role="" public_health_json_ok=""
  local got_runtime_mode="" got_container_identity="" got_container_started_at="" got_container_xray_token="" got_host_xray_pid="" got_host_xray_starttime=""
  local got_tunnel_declaration="" got_xray_public_listener="" got_cluster_sync="" got_node_name="" got_node_name_valid="" got_api_host="" got_access_host=""
  local public_health_target="" canary_local_target="" vless_public_target=""
  local public_result public_vless_status canary_probe canary_access_host canary_remainder canary_port vless_local
  expected="$(policy_values "$host")"
  while IFS='=' read -r key value; do
    case "$key" in
      cloudflare_tunnel) want_cloudflare_tunnel="$value" ;;
      cloudflare_ddns) want_cloudflare_ddns="$value" ;;
      ip_geo_enrichment) want_ip_geo_enrichment="$value" ;;
      managed_default_vless) want_managed_default_vless="$value" ;;
      managed_default_ss2022) want_managed_default_ss2022="$value" ;;
      direct_docker) allow_direct_docker="$value" ;;
      public_hostname_zone) public_hostname_zone="$value" ;;
    esac
  done <<< "$expected"

  basic_raw="$(read_audit_result "$host" "$allow_direct_docker" "$want_managed_default_vless")" || die "audit probe failed for ${host}"
  raw="$(normalize_audit_result basic "$basic_raw")" || die "audit probe returned an invalid basic response for ${host}"
  while IFS='=' read -r key value; do
    case "$key" in
      xp_service) got_xp_service="$value" ;;
      xray_service) got_xray_service="$value" ;;
      cloudflared_service) got_cloudflared_service="$value" ;;
      cloudflare_tunnel) got_cloudflare_tunnel="$value" ;;
      cloudflare_ddns_enabled) got_cloudflare_ddns_enabled="$value" ;;
      cloudflare_ddns) got_cloudflare_ddns="$value" ;;
      ip_geo_enrichment) got_ip_geo_enrichment="$value" ;;
      managed_default_vless) got_managed_default_vless="$value" ;;
      managed_default_ss2022) got_managed_default_ss2022="$value" ;;
      canary_enabled) got_canary_enabled="$value" ;;
      canary_certificate) got_canary_certificate="$value" ;;
      vless_ingress) got_vless_ingress="$value" ;;
      local_health) got_local_health="$value" ;;
      xray_runtime) got_xray_runtime="$value" ;;
      public_health) got_public_health="$value" ;;
      public_health_target) public_health_target="$value" ;;
      canary_local_target) canary_local_target="$value" ;;
      vless_public_target) vless_public_target="$value" ;;
      tunnel_declaration) got_tunnel_declaration="$value" ;;
      xray_public_listener) got_xray_public_listener="$value" ;;
      cluster_sync) got_cluster_sync="$value" ;;
      cluster_role) got_cluster_role="$value" ;;
      runtime_mode) got_runtime_mode="$value" ;;
      container_identity) got_container_identity="$value" ;;
      container_started_at) got_container_started_at="$value" ;;
      container_xray_token) got_container_xray_token="$value" ;;
      host_xray_pid) got_host_xray_pid="$value" ;;
      host_xray_starttime) got_host_xray_starttime="$value" ;;
      node_name) got_node_name="$value" ;;
      node_name_valid) got_node_name_valid="$value" ;;
      api_host) got_api_host="$value" ;;
      access_host) got_access_host="$value" ;;
    esac
  done <<< "$raw"

  local private_docker_exception=false
  if [ "$allow_direct_docker" = true ] && [ "$want_cloudflare_tunnel" = false ] && [ "$want_managed_default_vless" = false ]; then
    private_docker_exception=true
    if [ "$got_runtime_mode" != container ]; then
      echo "FAIL private_docker_runtime_mode" >&2
      failed=1
    fi
  fi
  if [ "$private_docker_exception" = false ]; then
    expected_api_host="${got_node_name}-xp.${public_hostname_zone}"
    expected_access_host="${got_node_name}-ep.${public_hostname_zone}"
    if [ "$got_node_name_valid" = true ] && [ "$got_api_host" = "$expected_api_host" ] && [ "$got_access_host" = "$expected_access_host" ]; then
      echo "PASS public_hostname_convention"
    else
      echo "FAIL public_hostname_convention"
      failed=1
    fi
  else
    echo "SKIP public_hostname_convention (approved private-node exception)"
  fi
  if [ -n "$public_health_target" ] && [ "$private_docker_exception" = false ]; then
    public_probe="$(validate_public_target "$public_health_target" /api/health)" || die "audit returned an unsafe public health target"
    IFS="$(printf '\t')" read -r public_health_target public_resolve public_ip <<< "$public_probe"
    public_headers="$(mktemp)" || die "failed to create a public health header file"
    AUDIT_TEMP_FILE="$public_headers"
    public_health="$(curl_bounded_headers "$public_headers" -fsS --noproxy '*' --max-time 15 --max-filesize "$MAX_AUDIT_RESPONSE_BYTES" --resolve "$public_resolve" -- "$public_health_target" 2>/dev/null)" || die "public health probe failed for ${host}"
    public_result="$(printf '%s' "$public_health" | "${AUDIT_LOCAL_SCRIPT}" public-health)" || die "public health probe returned invalid JSON for ${host}"
    while IFS='=' read -r key value; do
      case "$key" in
        public_health) got_public_health="$value" ;;
        public_health_json_ok) public_health_json_ok="$value" ;;
      esac
    done <<< "$public_result"
    if [ "$want_cloudflare_tunnel" = true ]; then got_cloudflare_tunnel=false; fi
    if [ "$want_cloudflare_tunnel" = true ] && [ "$got_tunnel_declaration" = aligned ] && is_cloudflare_ip "$public_ip" && grep -Eiq '^server:[[:space:]]*cloudflare[[:space:]]*$' "$public_headers" && grep -Eiq '^cf-ray:' "$public_headers" && [ "$public_health_json_ok" = true ]; then
      got_cloudflare_tunnel=true
    fi
    rm -f "$public_headers"
    AUDIT_TEMP_FILE=""
  fi
  if [ "$want_managed_default_vless" = true ]; then
    got_vless_ingress=false
  fi
  if [ -n "$canary_local_target" ] && [ "$want_managed_default_vless" = true ]; then
    canary_probe="$(validate_public_target "$canary_local_target" /generate_204)" || die "audit returned an unsafe local canary target"
    IFS="$(printf '\t')" read -r _canary_target canary_resolve _canary_ip <<< "$canary_probe"
    canary_access_host="${canary_resolve%%:*}"
    canary_remainder="${canary_resolve#*:}"
    canary_port="${canary_remainder%%:*}"
    vless_local="$(read_vless_audit_result "$host" "$canary_access_host" "$canary_port" "$allow_direct_docker" "$got_runtime_mode" "$got_container_identity" "$got_container_started_at" "$got_host_xray_pid" "$got_host_xray_starttime" "$got_container_xray_token")" || die "VLESS loopback canary probe failed for ${host}"
    while IFS='=' read -r key value; do
      [ "$key" = vless_ingress ] && got_local_canary="$value"
    done <<< "$vless_local"
  fi
  if [ -n "$vless_public_target" ] && [ "$want_managed_default_vless" = true ]; then
    vless_probe="$(validate_public_target "$vless_public_target" /generate_204)" || die "audit returned an unsafe VLESS target"
    IFS="$(printf '\t')" read -r vless_public_target vless_resolve _vless_ip <<< "$vless_probe"
    public_vless_status="$(curl -sS --noproxy '*' --max-time 15 --resolve "$vless_resolve" -o /dev/null -w '%{http_code}' -- "$vless_public_target" 2>/dev/null || true)"
    if [ "$got_local_canary" = true ] && [ "$public_vless_status" = 204 ]; then
      got_vless_ingress=true
    else
      got_vless_ingress=false
      got_xray_public_listener=false
    fi
  fi

  check_expected cloudflare_tunnel "$want_cloudflare_tunnel" "$got_cloudflare_tunnel" || failed=1
  if [ "$want_cloudflare_ddns" = true ]; then
    if [ "$got_cloudflare_ddns_enabled" = true ]; then
      check_expected cloudflare_ddns true "$got_cloudflare_ddns" || failed=1
    else
      check_expected cloudflare_ddns true false || failed=1
    fi
  else
    check_expected cloudflare_ddns false "$got_cloudflare_ddns_enabled" || failed=1
  fi
  check_expected ip_geo_enrichment "$want_ip_geo_enrichment" "$got_ip_geo_enrichment" || failed=1
  check_expected managed_default_vless "$want_managed_default_vless" "$got_managed_default_vless" || failed=1
  check_expected managed_default_ss2022 "$want_managed_default_ss2022" "$got_managed_default_ss2022" || failed=1

  check_true xp_service "$got_xp_service" || failed=1
  check_true xray_service "$got_xray_service" || failed=1
  if [ "$want_cloudflare_tunnel" = true ]; then
    check_true cloudflared_service "$got_cloudflared_service" || failed=1
    case "$got_tunnel_declaration" in
      aligned) echo "PASS tunnel_declaration" ;;
      missing) echo "FAIL tunnel_declaration_missing"; failed=1 ;;
      *) echo "FAIL tunnel_declaration_mismatch"; failed=1 ;;
    esac
  else
    echo "SKIP cloudflared_service (approved Tunnel exception)"
  fi
  check_true cluster_sync "$got_cluster_sync" || failed=1
  if [ "$want_managed_default_vless" = true ]; then
    check_true xray_public_listener "$got_xray_public_listener" || failed=1
    check_true canary_enabled "$got_canary_enabled" || failed=1
    check_true canary_certificate "$got_canary_certificate" || failed=1
    check_true local_canary "$got_local_canary" || failed=1
    check_true vless_ingress "$got_vless_ingress" || failed=1
  else
    echo "SKIP canary_enabled (approved VLESS exception)"
    echo "SKIP canary_certificate (approved VLESS exception)"
    echo "SKIP local_canary (approved VLESS exception)"
    echo "SKIP vless_ingress (approved VLESS exception)"
  fi
  check_true local_health "$got_local_health" || failed=1
  check_true xray_runtime "$got_xray_runtime" || failed=1
  if [ "$private_docker_exception" = false ]; then
    check_true public_health "$got_public_health" || failed=1
  else
    echo "SKIP public_health (approved private-node exception)"
  fi

  case "$got_cluster_role" in
    leader|follower) echo "PASS cluster_role=${got_cluster_role}" ;;
    *) echo "FAIL cluster_role"; failed=1 ;;
  esac

  if [ "$failed" -ne 0 ]; then
    echo "audit: FAILED (${host}); do not declare deployment complete" >&2
    return 1
  fi
  echo "audit: OK (${host})"
}

validate_public_target() {
  local target="$1" expected_path="$2"
  require_ruby_yaml
  ruby -ruri -rresolv -ripaddr -e '
    target, expected_path = ARGV
    uri = URI.parse(target)
    reject = -> { exit 1 }
    reject.call unless uri.is_a?(URI::HTTPS) && uri.userinfo.nil? && uri.query.nil? && uri.fragment.nil?
    reject.call unless uri.path == expected_path && uri.host && uri.host.include?(".")
    begin
      IPAddr.new(uri.host)
      reject.call
    rescue IPAddr::InvalidAddressError
    end
    addresses = Resolv.getaddresses(uri.host)
    reject.call if addresses.empty?
    denied = %w[
      0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16
      172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.168.0.0/16
      192.88.99.0/24 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24
      224.0.0.0/4 240.0.0.0/4
      2001::/23 2001:db8::/32 2002::/16 3fff::/20
    ].map { |cidr| IPAddr.new(cidr) }
    parsed = addresses.map { |address| IPAddr.new(address) }
    ipv6_global_unicast = IPAddr.new("2000::/3")
    globally_reachable_exceptions = %w[
      192.0.0.9 192.0.0.10 64:ff9b::/96 2001:1::1/128 2001:1::2/128
      2001:1::3/128 2001:3::/32 2001:4:112::/48 2001:20::/28 2001:30::/28
    ].map { |value| IPAddr.new(value) }
    reject.call if parsed.any? do |address|
      !globally_reachable_exceptions.any? { |range| range.include?(address) } && (
        denied.any? { |range| range.ipv4? == address.ipv4? && range.include?(address) } ||
          (address.ipv6? && !ipv6_global_unicast.include?(address))
      )
    end
    address = parsed.first.to_s
    address = "[#{address}]" if parsed.first.ipv6?
    port = uri.port
    puts [target, "#{uri.host}:#{port}:#{address}", parsed.first.to_s].join("\t")
  ' "$target" "$expected_path"
}

is_cloudflare_ip() {
  local address="$1" ranges ranges_v4 ranges_v6
  ranges_v4="$(curl_bounded -fsS --noproxy '*' --max-time 15 --max-filesize "$MAX_AUDIT_RESPONSE_BYTES" https://www.cloudflare.com/ips-v4 2>/dev/null)" || return 1
  ranges_v6="$(curl_bounded -fsS --noproxy '*' --max-time 15 --max-filesize "$MAX_AUDIT_RESPONSE_BYTES" https://www.cloudflare.com/ips-v6 2>/dev/null)" || return 1
  ranges="${ranges_v4}
${ranges_v6}"
  printf '%s\n' "$ranges" | ruby -ripaddr -e '
    address = IPAddr.new(ARGV.fetch(0))
    ranges = STDIN.each_line.map(&:strip).reject(&:empty?).map { |line| IPAddr.new(line) }
    exit(ranges.any? { |range| range.include?(address) } ? 0 : 1)
  ' "$address"
}

check_expected() {
  local key="$1" expected="$2" actual="${3:-missing}"
  if [ "$actual" = "$expected" ]; then
    echo "PASS ${key}"
  else
    echo "FAIL ${key} expected=${expected} actual=${actual}"
    return 1
  fi
}

check_true() {
  local key="$1" actual="${2:-missing}"
  if [ "$actual" = "true" ]; then
    echo "PASS ${key}"
  else
    echo "FAIL ${key}"
    return 1
  fi
}

read_hosts() {
  [ -f "${HOSTS_FILE}" ] || die "missing hosts file: ${HOSTS_FILE}"
  while IFS= read -r line || [ -n "$line" ]; do
    # Strip comments and trim whitespace.
    line="${line%%#*}"
    line="$(echo "$line" | xargs || true)"
    [ -n "$line" ] || continue
    printf '%s\n' "$line"
  done < "${HOSTS_FILE}"
}

ssh_base() {
  local host="$1"
  shift

  require_operator_account "$host"

  ssh \
    -n \
    -o BatchMode=yes \
    -o ConnectTimeout="${SSH_CONNECT_TIMEOUT_SECS}" \
    "$host" "$@"
}

port_preflight_ssh() {
  local host="$1"
  shift

  require_operator_account "$host"
  ruby -e '
    limit = Integer(ARGV.shift)
    pid = Process.spawn(*ARGV)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + limit
    loop do
      waited = Process.waitpid(pid, Process::WNOHANG)
      exit($?.exitstatus || 1) if waited
      if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
        Process.kill("TERM", pid) rescue nil
        sleep 1
        Process.kill("KILL", pid) rescue nil
        Process.waitpid(pid) rescue nil
        exit 124
      end
      sleep 0.05
    end
  ' "$PORT_PREFLIGHT_EXEC_TIMEOUT_SECS" \
    ssh \
      -n \
      -o BatchMode=yes \
      -o ConnectTimeout="${SSH_CONNECT_TIMEOUT_SECS}" \
      "$host" "$@"
}

ssh_cfg() {
  local host="$1"
  local key="$2"
  ssh -G "$host" 2>/dev/null | awk -v k="$key" '$1==k {print $2; exit}'
}

require_operator_account() {
  local host="$1"
  require_registered_host "$host"
  local user

  user="$(ssh_cfg "$host" user)"
  case "$user" in
    root|xp)
      die "refusing SSH alias ${host}: configure a non-root operator account"
      ;;
  esac
}

require_registered_host() {
  local host="$1"
  local line name found=false
  local seen_names=$'\n'
  [ -f "${HOSTS_FILE}" ] || die "missing hosts file: ${HOSTS_FILE}"
  while IFS= read -r line || [ -n "$line" ]; do
    name="${line%%#*}"
    name="${name#"${name%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
    [ -n "$name" ] || continue
    case "$name" in
      [a-z0-9]* ) ;;
      * ) die "hosts inventory is invalid" ;;
    esac
    case "$name" in
      *[!a-z0-9-]* ) die "hosts inventory is invalid" ;;
    esac
    case "$seen_names" in
      *$'\n'"$name"$'\n'*) die "hosts inventory is invalid" ;;
    esac
    seen_names+="${name}"$'\n'
    [ "$name" != "$host" ] || found=true
  done < "${HOSTS_FILE}"
  [ "$found" = true ] || die "host is not registered in ${HOSTS_FILE}"
}

remote_sshd_t_value() {
  local host="$1"
  local key="$2"

  # Best-effort: if sudo or sshd is unavailable, return empty and let callers decide.
  ssh_base "$host" "sudo -n sshd -T 2>/dev/null | awk -v k=\"$key\" '\$1==k {print \$2; exit}'" 2>/dev/null || true
}

remote_probe_kv() {
  local host="$1"
  # shellcheck disable=SC2016
  ssh_base "$host" 'set -e
if [ -f /etc/os-release ]; then
  . /etc/os-release
  echo "os_pretty=${PRETTY_NAME:-}"
  echo "os_id=${ID:-}"
  echo "os_version=${VERSION_ID:-}"
else
  echo "os_pretty=$(uname -s)"
  echo "os_id="
  echo "os_version="
fi

svc_mgr=unknown
if command -v rc-service >/dev/null 2>&1; then
  svc_mgr=openrc
elif command -v systemctl >/dev/null 2>&1; then
  svc_mgr=systemd
fi
echo "svc_mgr=$svc_mgr"

xp_bin=""
if [ -x /usr/local/bin/xp ]; then
  xp_bin=/usr/local/bin/xp
elif command -v xp >/dev/null 2>&1; then
  xp_bin="$(command -v xp)"
fi

if [ -n "$xp_bin" ]; then
  echo "xp_present=yes"
  echo "xp_bin=$xp_bin"
  ver=$("$xp_bin" --version 2>/dev/null || "$xp_bin" -V 2>/dev/null || echo unknown)
  echo "xp_version=$ver"
else
  echo "xp_present=no"
  echo "xp_bin="
  echo "xp_version="
fi

ui_listen=no
metrics_listen=no
if command -v ss >/dev/null 2>&1; then
  if ss -ltn 2>/dev/null | grep -q ":62416"; then ui_listen=yes; fi
  if ss -ltn 2>/dev/null | grep -q ":10085"; then metrics_listen=yes; fi
elif command -v netstat >/dev/null 2>&1; then
  if netstat -ltn 2>/dev/null | grep -q ":62416"; then ui_listen=yes; fi
  if netstat -ltn 2>/dev/null | grep -q ":10085"; then metrics_listen=yes; fi
fi
echo "ui_listen=$ui_listen"
echo "metrics_listen=$metrics_listen"
'
}

cmd_inventory() {
  local host hostname port user
  local os_pretty svc_mgr xp_present xp_version ui_listen metrics_listen
  local hosts

  hosts="$(read_hosts)" || exit 1

  while IFS= read -r host; do
    [ -n "$host" ] || continue
    hostname="$(ssh_cfg "$host" hostname || true)"
    port="$(ssh_cfg "$host" port || true)"
    user="$(ssh_cfg "$host" user || true)"

    echo "== ${host} =="
    echo "ssh: user=${user:-?} host=${hostname:-?} port=${port:-?}"

    os_pretty=""
    svc_mgr=""
    xp_present=""
    xp_version=""
    ui_listen=""
    metrics_listen=""

    local out line key val
    if ! out="$(remote_probe_kv "$host" 2>/dev/null)"; then
      echo "probe: FAILED"
      echo
      continue
    fi

    while IFS= read -r line; do
      [ -n "$line" ] || continue
      key="${line%%=*}"
      val="${line#*=}"
      case "$key" in
        os_pretty) os_pretty="$val" ;;
        svc_mgr) svc_mgr="$val" ;;
        xp_present) xp_present="$val" ;;
        xp_version) xp_version="$val" ;;
        ui_listen) ui_listen="$val" ;;
        metrics_listen) metrics_listen="$val" ;;
      esac
    done <<< "$out"

    echo "os: ${os_pretty:-unknown}"
    echo "svc_mgr: ${svc_mgr:-unknown}"
    echo "xp_present: ${xp_present:-unknown}"
    if [ -n "${xp_version:-}" ]; then
      echo "xp_version: ${xp_version}"
    fi
    echo "listen: ui_62416=${ui_listen:-unknown} metrics_10085=${metrics_listen:-unknown}"
    echo
  done <<< "$hosts"
}

cmd_status() {
  local host="${1:-}"
  [ -n "$host" ] || die "missing <host>"
  ssh_base "$host" 'set -e
if command -v rc-service >/dev/null 2>&1; then
  sudo -n rc-service xp status
elif command -v systemctl >/dev/null 2>&1; then
  sudo -n systemctl status xp --no-pager
else
  echo "unknown service manager (need rc-service or systemctl)" >&2
  exit 2
fi
'
}

cmd_logs() {
  local host="${1:-}"
  shift || true
  [ -n "$host" ] || die "missing <host>"

  local tail_lines=200
  while [ $# -gt 0 ]; do
    case "$1" in
      --tail)
        tail_lines="${2:-}"
        [ -n "$tail_lines" ] || die "--tail requires a number"
        shift 2
        ;;
      *)
        die "unknown arg: $1"
        ;;
    esac
  done

  ssh_base "$host" "set -e
if command -v rc-service >/dev/null 2>&1; then
  if ! sudo -n true 2>/dev/null; then
    echo 'xp logs unavailable: sudo -n is required for OpenRC diagnostics' >&2
    exit 1
  elif sudo -n test -f /var/log/xp.log; then
    sudo -n tail -n ${tail_lines} /var/log/xp.log
  else
    echo 'xp logs unavailable: this OpenRC service has no persistent /var/log/xp.log; returning health instead' >&2
    curl -fsS http://127.0.0.1:62416/api/health
  fi
elif command -v systemctl >/dev/null 2>&1; then
  sudo -n journalctl -u xp --no-pager -n ${tail_lines}
else
  echo \"unknown service manager (need rc-service or systemctl)\" >&2
  exit 2
fi
"
}

cmd_version() {
  local host="${1:-}"
  [ -n "$host" ] || die "missing <host>"
  ssh_base "$host" 'set -e
if [ -x /usr/local/bin/xp ]; then
  /usr/local/bin/xp --version
elif command -v xp >/dev/null 2>&1; then
  xp --version
else
  echo "xp: missing"
  exit 1
fi
'
}

cmd_tunnel() {
  local host="${1:-}"
  shift || true
  [ -n "$host" ] || die "missing <host>"

  require_operator_account "$host"

  local mode="ui"
  local local_port=""
  local allowtcpforwarding=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ui) mode="ui"; shift ;;
      --metrics) mode="metrics"; shift ;;
      --local-port)
        local_port="${2:-}"
        [ -n "$local_port" ] || die "--local-port requires a number"
        shift 2
        ;;
      *) die "unknown arg: $1" ;;
    esac
  done

  local remote_port
  case "$mode" in
    ui) remote_port=62416 ;;
    metrics) remote_port=10085 ;;
    *) die "invalid mode: $mode" ;;
  esac

  if [ -z "${local_port}" ]; then
    local_port="${remote_port}"
  fi

  if command -v lsof >/dev/null 2>&1; then
    if lsof -nP -iTCP:"${local_port}" -sTCP:LISTEN >/dev/null 2>&1; then
      warn "local port ${local_port} is already in use; choose another with --local-port"
    fi
  fi

  # Many hardened hosts disable forwarding. Detect and fail with a clear hint.
  allowtcpforwarding="$(remote_sshd_t_value "$host" allowtcpforwarding)"
  if [ -n "${allowtcpforwarding}" ] && [ "${allowtcpforwarding}" = "no" ]; then
    die "SSH server disallows TCP forwarding (AllowTcpForwarding no). See ${REF_DIR}/runbook.md for how to enable it safely."
  fi

  echo "tunnel: localhost:${local_port} -> ${host}:127.0.0.1:${remote_port}" >&2
  echo "press Ctrl+C to stop" >&2

  ssh \
    -n \
    -o BatchMode=yes \
    -o ConnectTimeout="${SSH_CONNECT_TIMEOUT_SECS}" \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -L "${local_port}:127.0.0.1:${remote_port}" \
    "$host" -N
}

main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    inventory) cmd_inventory "$@" ;;
    policy) cmd_policy "$@" ;;
    port) cmd_port "$@" ;;
    audit) cmd_audit "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    version) cmd_version "$@" ;;
    tunnel) cmd_tunnel "$@" ;;
    help|-h|--help|"") usage ;;
    *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
