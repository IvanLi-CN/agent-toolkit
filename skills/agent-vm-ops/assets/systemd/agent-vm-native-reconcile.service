[Unit]
Description=Reconcile native agent VM state after boot
After=incus.service
Wants=incus.service

[Service]
Type=oneshot
UnsetEnvironment=AGENT_VM_CONFIG_PATH
ExecStart=/usr/bin/bun /opt/agent-vm-native/agent_vm_control.ts --timer-reconcile
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
